{
    "gamename": "Hokm",
    "players": 2,
    "zones": {
        "deck": {},
        "discard": {},
        "hand": {"quantity": 2},
        "check": {"quantity": 2}
    },
    "variables": {
    },
    "init": [
        "_zones.deck:load_collection('cards', Card):shuffle()"
    ],
    "gamestates": {
        "deal": {
            "initial": true,
            "on_enter": [
                "_zones.deck:deal(_zones.hand[1], 5)",
                "_zones.deck:deal(_zones.hand[2], 5)",
                "wait_for_action('hakem_discard')",
                "wait_for_action('dealer_discard')"
            ],
            "transitions": {
                "_": ["draft"]
            }
        },
        "draft": {
            "on_enter": [
                "-- scripts to run on entering state"
            ],
            "transition": {
                "_": 
            }
        },
        "end": {
            "on_enter": [

            ]
        }
    },
    "actions": {
        "hakem_discard": {
            "condition": [
                "player == 1",
                "states.deal"
            ],
            "targets": {
                "name": "target",
                "candidates": ["hand[1]"],
                "min_targets": 3
            },
            "execution": [
                "for _,c in ipairs(target) do c:send_to(_zones.discard) end"
            ]
        }
    }
}