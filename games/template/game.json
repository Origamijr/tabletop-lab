{
    "gamename": "Template",
    "players": 2,
    "zones": {
        "deck": {"quantity": 1},
        "hand": {"quantity": 2}
    },
    "variables": {
        "var": "-- set on init",
        "current_player": 1
    },
    "init": [ 
        "-- scripts to call on initialization",
        "zones.deck:load_collection('collection', Card, {}):shuffle()"
    ],
    "gamestates": {
        "deal": {
            "initial": true,
            "on_enter": [
                "-- scripts to run on entering state",
                "zones.deck:deal(zones.hand[1], 5)",
                "return 'this_wont_happen'"
            ],
            "transitions": [
                {"conditions": ["#zones.hand[1]<5","false"], "next_state": ["this_wont_happen","nondeterministic_transition"]},
                {"conditions": ["signaled('sig')"], "next_state": "end"},
                {"conditions": ["signaled('this_wont_happen')"], "next_state": "this_wont_happen"},
                {"conditions": ["true"], "next_state": "default_but_this_wont_happen"}
            ]
        },
        "end": {
            "on_enter": [
                "end_game({'winner': 1})"
            ]
        }
    },
    "actions": {
        "action_1": {
            "condition": [
                "true -- expressions that must evaluate to true",
                "state.deal -- state is a dictionary that maps state to a boolean indicating if it's active",
                "player = current_player -- player (possibly) taking the action can be accessed via 'player'"
            ],
            "targets": {
                "name": "t",
                "candidates": ["zones.hand[player]"],
                "condition": "function(c) return c.value != 'A'",
                "min_targets": 1,
                "max_targets": 2
            },
            "execution": [
                "t:send_to(deck)",
                "return 'sig'"
            ]
        }
    }
}